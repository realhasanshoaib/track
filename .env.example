# Track local environment example.
# Copy to .env.local or the platform-specific env store and fill values there.
# Do not commit real secrets.

# Convex default/local development
VITE_CONVEX_URL=https://your-development-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-development-deployment.convex.site
CONVEX_SITE_URL=https://your-development-deployment.convex.site
CONVEX_DEPLOYMENT=dev:your-development-deployment
CONVEX_DEPLOY_KEY=

# Convex development
VITE_CONVEX_URL_DEV=https://your-development-deployment.convex.cloud
CONVEX_SITE_URL_DEV=https://your-development-deployment.convex.site
CONVEX_DEPLOYMENT_DEV=dev:your-development-deployment
CONVEX_DEPLOY_KEY_DEV=

# Convex production
VITE_CONVEX_URL_PROD=https://your-production-deployment.convex.cloud
VITE_CONVEX_SITE_URL_PROD=https://your-production-deployment.convex.site
CONVEX_SITE_URL_PROD=https://your-production-deployment.convex.site
CONVEX_DEPLOYMENT_PROD=prod:your-production-deployment
CONVEX_DEPLOY_KEY_PROD=

# App URLs
APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
PRODUCTION_APP_URL=https://your-domain.example

# Default-on release controls (server-authoritative; exact false disables)
TRACK_COMPANY_MODEL_ENABLED=true
TRACK_TASKS_ENABLED=true
TRACK_THREADS_ENABLED=true

# Auth
AUTH_SECRET=
DEV_AUTH_BYPASS=
VITE_DEV_AUTH_BYPASS=
VITE_DEV_AUTH_BYPASS_PASSWORD=
EXPO_PUBLIC_DEV_AUTH_BYPASS=
EXPO_PUBLIC_DEV_AUTH_BYPASS_PASSWORD=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_SECRET_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID_UPLOAD=
GOOGLE_CLIENT_ID_ANDROID_PLAY_SIGNING=
TOTP_ENCRYPTION_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Track <no-reply@your-domain.example>

# AI
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-5.6-luna
AI_DOCUMENT_READER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_APP_URL=https://your-domain.example
OPENROUTER_APP_TITLE=Track
OPENROUTER_APP_CATEGORIES=general-chat

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Native mobile push (Convex server-side values)
TRACK_PUSH_ENVIRONMENT=development
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.track
APNS_DEVELOPMENT_KEY_ID=
APNS_DEVELOPMENT_PRIVATE_KEY=
APNS_PRODUCTION_KEY_ID=
APNS_PRODUCTION_PRIVATE_KEY=
FCM_V1_SERVICE_ACCOUNT_JSON=
FCM_ANDROID_PACKAGE=com.example.track

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Observability
AXIOM_TOKEN=
AXIOM_DATASET=track
AXIOM_ORG_ID=
OBSERVABILITY_RETENTION_EVENTS_DAYS=30
OBSERVABILITY_RETENTION_ERRORS_DAYS=90

# Mobile / EAS metadata
EXPO_PUBLIC_CONVEX_URL=https://your-production-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-production-deployment.convex.site
EXPO_PUBLIC_APP_URL=https://your-domain.example
EXPO_PUBLIC_APP_ENV=development
APPLE_CLIENT_ID=com.example.track
APPLE_CLIENT_SECRET=
EXPO_ACCOUNT=your-expo-account
EXPO_PROJECT_SLUG=track
IOS_BUNDLE_IDENTIFIER=com.example.track
ANDROID_PACKAGE=com.example.track
APP_STORE_CONNECT_APP_ID=
GOOGLE_PLAY_APP_ID=

# Local credential file pointers
GOOGLE_OAUTH_WEB_CLIENT_FILE=.credentials/google-oauth-web-client.json
GOOGLE_OAUTH_IOS_CLIENT_FILE=.credentials/google-oauth-ios-client.plist
GOOGLE_OAUTH_ANDROID_UPLOAD_CLIENT_FILE=.credentials/google-oauth-android-upload-client.json
GOOGLE_OAUTH_ANDROID_PLAY_SIGNING_CLIENT_FILE=.credentials/google-oauth-android-play-signing-client.json
GOOGLE_SERVICES_JSON=.credentials/google-services.json
FCM_V1_SERVICE_ACCOUNT_FILE=.credentials/fcm-service-account.json
APNS_DEVELOPMENT_PRIVATE_KEY_FILE=.credentials/apns-development-key.p8
APNS_PRODUCTION_PRIVATE_KEY_FILE=.credentials/apns-production-key.p8
PLAY_SUBMIT_SERVICE_ACCOUNT_FILE=.credentials/play-submit-service-account.json
APP_STORE_CONNECT_API_KEY_FILE=.credentials/app-store-connect-api-key.p8
