# EAS needs these ignored operator files to resolve the release profile and app
# identity inside the isolated build archive.
!apps/mobile/eas.json
!apps/mobile/app.json
!apps/mobile/google-services.json

# Let EAS regenerate Android from the release config so config plugins (notably
# Firebase/FCM) are applied instead of uploading a stale local native project.
apps/mobile/android
