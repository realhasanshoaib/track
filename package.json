{
  "name": "track",
  "description": "Chat-first project collaboration with evidence-grounded AI assistance.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hhushhas/track.git"
  },
  "homepage": "https://github.com/hhushhas/track#readme",
  "bugs": {
    "url": "https://github.com/hhushhas/track/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "turbo dev --concurrency=2",
    "build": "turbo build --concurrency=1",
    "typecheck": "pnpm run typecheck:backend && NODE_OPTIONS=--max-old-space-size=1024 turbo typecheck --concurrency=1",
    "typecheck:backend": "tsc -p convex/tsconfig.json --noEmit",
    "lint": "turbo lint --concurrency=1 && pnpm run lint:backend",
    "lint:backend": "oxlint convex",
    "architecture:semgrep": "node scripts/gates/semgrep-ratchet.mjs",
    "test": "VITEST_MAX_WORKERS=1 turbo test --concurrency=1 && VITEST_MAX_WORKERS=1 vitest run --config vitest.config.ts --environment node --no-file-parallelism",
    "e2e": "playwright test --config e2e/playwright.config.ts e2e/tests/track-journeys.spec.ts e2e/tests/task-editing.spec.ts",
    "perf:fixture": "PERF_OUTPUT_PATH=artifacts/performance/fixture-performance.json playwright test --config e2e/playwright.config.ts e2e/tests/performance.spec.mjs",
    "perf:build": "node scripts/perf/measure-web-build.mjs",
    "gate": "pnpm check:tracker && pnpm test:tracker && q9gate run",
    "gate:full": "pnpm check:tracker && pnpm test:tracker && q9gate run --full",
    "convex:dev": "convex dev",
    "convex:deploy:dev": "convex deploy",
    "convex:deploy:prod": "convex deploy --env-file convex.prod.env",
    "generate:tracker": "node scripts/generate-tracker.mjs",
    "check:tracker": "node scripts/generate-tracker.mjs --check",
    "serve:tracker": "node scripts/tracker-server.mjs",
    "test:tracker": "node --test scripts/tracker.node-test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@q9labsai/config-depcruise": "0.1.0",
    "@q9labsai/config-oxlint": "0.1.0",
    "@q9labsai/config-semgrep": "0.1.0",
    "@q9labsai/config-tsconfig": "0.1.0",
    "@q9labsai/gates": "0.1.0",
    "@types/node": "^25.9.5",
    "@types/web-push": "^3.6.4",
    "convex": "^1.42.1",
    "convex-test": "0.0.54",
    "dependency-cruiser": "18.2.0",
    "js-yaml": "4.3.1",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.4",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@track/shared": "workspace:*",
    "@upstash/box": "0.4.4",
    "ai": "^6.0.223",
    "better-auth": "1.6.25",
    "fflate": "0.8.3",
    "firebase-admin": "14.2.0",
    "hono": "4.12.34",
    "jose": "6.2.5",
    "react": "19.2.7",
    "sharp": "0.35.3",
    "web-push": "^3.6.7"
  }
}
